# Rename this file to .env and fill in your credentials.
# .env is gitignored — never commit real tokens.

TELEGRAM_BOT_TOKEN=paste_your_token_from_botfather_here
TELEGRAM_CHAT_ID=paste_your_chat_id_here

# SEC EDGAR requires a User-Agent with a name and contact email (backtest only).
SEC_USER_AGENT=Your Name your.email@example.com
